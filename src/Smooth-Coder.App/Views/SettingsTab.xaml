<UserControl x:Class="SmoothCoder.App.Views.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SmoothCoder.App.ViewModels"
             xmlns:conv="clr-namespace:SmoothCoder.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="500" d:DesignWidth="900">

    <UserControl.Resources>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="設定" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />

            <ui:Card Margin="0,0,0,16">
                <StackPanel Margin="4">
                    <TextBlock Text="AIごとの起動コマンド" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="プロジェクトが各AIで「起動」するとき、標準で使われる実行コマンドとオプションです。実行ファイル名や再開の挙動はCLIのバージョンによって変わることがあるため、ここで自由に書き換えられます。個別のプロジェクトだけ変えたい場合は、起動ボタン横のドロップダウンからその都度指定できます。"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding AgentRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="実行コマンド" FontSize="12" Opacity="0.7"
                                                   VerticalAlignment="Center" Margin="0,0,8,6" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                                 Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="起動オプション" FontSize="12" Opacity="0.7"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,16">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="利用上限からの自動再開" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6">
                            応答の途中で利用上限に達したことを検知したら、自動でタスクを続行します。Claude Code と Codex CLI の実際のトランスクリプトに記録された制限情報を使用します。下の「Claude ↔ Codex 自動引き継ぎ」もこの検知を入口にしているため、ここをOFFにすると引き継ぎも動きません。アプリを起動している間(タスクバーに常駐中も含む)のみ有効です。
                        </TextBlock>
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoResumeOnLimitEnabled}" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,16">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Claude ↔ Codex 自動引き継ぎ" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                                   Text="片方が利用上限に達したら、直近の会話を共有チェックポイントへ保存し、もう片方を約5秒後に起動して中断地点から続行します。両方とも上限に達している場合は、先にリセットされる方まで待ってからそちらで再開するため、往復を繰り返して止まることはありません。共有データはプロジェクト内ではなく AppData に保存されます。OFFの場合は同じAIをリセット時刻の5分後に再開します。" />
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding CrossAgentHandoffEnabled}" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,16">
                <StackPanel Margin="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="音声通知" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                                       Text="作業の節目を秘書口調の音声でお知らせします。応答の完了、承認待ち、上限の検知、もう片方のAIへの引き継ぎ、作業の再開、両方が上限に達して待機に入ったとき、自動再開に失敗したとき。Claude Code と Codex CLI に共通で、音声はこのアプリが一手に鳴らします。" />
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding VoiceNotificationEnabled}" />
                    </Grid>

                    <Grid Margin="0,16,0,0" IsEnabled="{Binding VoiceNotificationEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="応答の完了も知らせる" FontSize="13" Margin="0,0,0,2" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                                       Text="1ターン終わって次の指示待ちになるたびにお知らせします。無人運転の節目だけ聞きたい場合はここをOFFにしてください。" />
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding VoiceTurnCompleteEnabled}" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="音量" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding VoiceNotificationVolumePercent}" />
                        <TextBlock Grid.Column="2" MinWidth="42" TextAlignment="Right" FontSize="12" VerticalAlignment="Center"
                                   Text="{Binding VoiceNotificationVolumePercent, StringFormat='{}{0:F0}%'}" />
                        <ui:Button Grid.Column="3" Content="テスト再生" Appearance="Secondary" Margin="12,0,0,0"
                                   Command="{Binding TestVoiceCommand}" />
                    </Grid>

                    <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.45" Margin="0,10,0,0"
                               Text="音量はこのアプリ内での相対値です（波形の振幅を調整しているため、Windows側のミキサー音量とは別に効きます）。「承認待ち」の通知だけは Claude Code 専用のフックが元になっているため、Codex CLI のプロジェクトでは鳴りません。鳴らすのはこのアプリなので、終了している間は通知されません（Claude Code 側で音を鳴らしていた旧フックは廃止しました）。" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,16">
                <StackPanel Margin="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="利用状況を実測で表示" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6">
                                Claude Code の status line 経由でアカウントの実際の消費率
                                (<Run Text="/usage" FontFamily="Consolas" /> と同じ数値)を取得し、ダッシュボードのバーに「実測」として表示します。
                                ON にすると <Run Text="~/.claude/settings.json" FontFamily="Consolas" /> の
                                <Run Text="statusLine" FontFamily="Consolas" /> にランチャーのブリッジを登録します(変更前に .bak を作成、OFF で元に戻します)。
                                副作用として Claude Code のフッターのキーヒント(esc to interrupt など)が非表示になります。数値は Pro/Max 購読者のみ、かつ API 応答のたびに更新されます。
                            </TextBlock>
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="{Binding UsageStatusLineBridgeEnabled}" />
                    </Grid>
                    <TextBlock Text="{Binding UsageStatusLineBridgeError}" TextWrapping="Wrap" FontSize="11"
                               Foreground="#D13438" Margin="0,8,0,0"
                               Visibility="{Binding UsageStatusLineBridgeError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,16">
                <StackPanel Margin="4">
                    <TextBlock Text="再開時の会話" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,0,0,16">
                        自動再開と「再開」ボタンが
                        <Run Text="-c" FontFamily="Consolas" />
                        で起動するとき、直前の会話をどう引き継ぐかです。長く大きく育った会話ではClaude Code側が確認画面を出して入力待ちで止まってしまうため、ここで選んだほうをランチャーが代わりに答えます。
                    </TextBlock>

                    <ComboBox ItemsSource="{Binding ResumeModeOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding ResumeMode}"
                              HorizontalAlignment="Left" MinWidth="280" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding ResumeModeDetail}" TextWrapping="Wrap" FontSize="11" Opacity="0.45" Margin="0,0,0,4" />
                    <TextBlock Text="Claude Code のプロジェクトにのみ適用されます。他のAIには /compact や再開確認の抑制に相当する仕組みがありません。"
                               TextWrapping="Wrap" FontSize="11" Opacity="0.45" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,16">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Windows起動時に自動起動" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                                   Text="サインイン時にタスクバーへ常駐した状態で自動的に起動します。" />
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding StartWithWindowsEnabled}" />
                </Grid>
            </ui:Card>

            <ui:Card>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="アップデート" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock FontSize="12" Opacity="0.6"
                                   Text="{Binding Update.CurrentVersionText, StringFormat='現在のバージョン: {0}'}" />
                        <TextBlock FontSize="11" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="{Binding Update.StatusText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="今すぐ確認" Appearance="Secondary" Margin="0,0,6,0"
                                   Command="{Binding Update.CheckNowCommand}" />
                        <ui:Button Content="再起動して適用" Appearance="Primary"
                                   Command="{Binding Update.ApplyCommand}" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
