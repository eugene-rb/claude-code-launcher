<ui:FluentWindow x:Class="ClaudeLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        xmlns:vm="clr-namespace:ClaudeLauncher.App.ViewModels"
        xmlns:conv="clr-namespace:ClaudeLauncher.App.Converters"
        xmlns:views="clr-namespace:ClaudeLauncher.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Claude Code ランチャー" Height="680" Width="960" MinHeight="420" MinWidth="680"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing">

    <ui:FluentWindow.Resources>
        <conv:BoolToStatusBrushConverter x:Key="StatusBrushConverter" />
        <conv:BoolToStatusTextConverter x:Key="StatusTextConverter" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <conv:HexToBrushConverter x:Key="HexToBrushConverter" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
        <conv:ActivityStateToTextConverter x:Key="ActivityStateTextConverter" />
        <conv:ActivityStateToBrushConverter x:Key="ActivityStateBrushConverter" />
        <conv:ActivityStateToVisibilityConverter x:Key="ActivityStateVisibilityConverter" />
        <conv:UpdateStateToIsReadyConverter x:Key="UpdateStateToIsReadyConverter" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tray:NotifyIcon x:Name="TrayIcon"
                          TooltipText="Claude Code ランチャー"
                          Icon="pack://application:,,,/Assets/app.ico"
                          MenuOnRightClick="True"
                          LeftClick="TrayIcon_LeftClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="開く" Click="TrayOpen_Click" />
                    <Separator />
                    <MenuItem Header="終了" Click="TrayExit_Click" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <ui:TitleBar Grid.Row="0" Title="Claude Code ランチャー" />

        <ui:Card Grid.Row="1" Margin="24,8,24,0"
                 Visibility="{Binding Update.State, Converter={StaticResource UpdateStateToIsReadyConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="4" VerticalAlignment="Center">
                    <TextBlock Text="アップデートの準備ができました" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Opacity="0.7"
                               Text="{Binding Update.AvailableVersion, StringFormat='v{0} をダウンロードしました。再起動して適用します。'}" />
                </StackPanel>

                <ui:Button Grid.Column="1" Content="再起動して更新" Appearance="Primary"
                           Command="{Binding Update.ApplyCommand}" VerticalAlignment="Center" />
            </Grid>
        </ui:Card>

        <TabControl Grid.Row="2" Margin="24,4,24,24" SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem Header="プロジェクト">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="プロジェクト" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="既存プロジェクトから追加" Appearance="Secondary" Margin="0,0,8,0"
                                       Icon="{ui:SymbolIcon Symbol=FolderArrowRight24}" Click="ImportProjects_Click" />
                            <ui:Button Content="新規プロジェクト" Appearance="Primary"
                                       Icon="{ui:SymbolIcon Symbol=Add24}" Click="AddSession_Click" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="{Binding Sessions.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                        <TextBlock FontSize="12" Opacity="0.75">
                            <Run Text="承認待ち" />
                            <Run Text="{Binding AwaitingApprovalCount, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  ・  応答中" />
                            <Run Text="{Binding RespondingCount, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  ・  待機" />
                            <Run Text="{Binding IdleCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Sessions.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <TextBlock Text="プロジェクトがまだありません" FontSize="16" Opacity="0.7" HorizontalAlignment="Center" />
                            <TextBlock Text="起動ディレクトリとオプションを設定して、最初のプロジェクトを作成しましょう" FontSize="12" Opacity="0.5"
                                       HorizontalAlignment="Center" Margin="0,4,0,16" />
                            <ui:Button Content="最初のプロジェクトを作成" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add24}"
                                       HorizontalAlignment="Center" Click="AddSession_Click" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding Sessions.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SessionItemViewModel}">
                                        <ui:Card Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" CornerRadius="3" Margin="0,2,16,2"
                                                        Background="{Binding AccentColorHex, Converter={StaticResource HexToBrushConverter}}" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding WorkingDirectory}" Opacity="0.7" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkingDirectory}" Margin="0,2,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding IsRunning, Converter={StaticResource StatusBrushConverter}}" />
                                                        <TextBlock Text="{Binding IsRunning, Converter={StaticResource StatusTextConverter}}"
                                                                   Margin="6,0,0,0" FontSize="12" />
                                                        <Ellipse Width="8" Height="8" Margin="14,0,0,0" VerticalAlignment="Center"
                                                                 Visibility="{Binding ActivityState, Converter={StaticResource ActivityStateVisibilityConverter}}"
                                                                 Fill="{Binding ActivityState, Converter={StaticResource ActivityStateBrushConverter}}" />
                                                        <TextBlock Text="{Binding ActivityState, Converter={StaticResource ActivityStateTextConverter}}"
                                                                   Margin="6,0,0,0" FontSize="12"
                                                                   Visibility="{Binding ActivityState, Converter={StaticResource ActivityStateVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="4"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                            Visibility="{Binding PreviewText, Converter={StaticResource NotNullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding PreviewText}" FontSize="11" Opacity="0.8"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" />
                                                    </Border>
                                                    <TextBlock Text="{Binding ScheduleSummary}" Opacity="0.55" FontSize="11" Margin="0,4,0,0"
                                                               Visibility="{Binding ScheduleSummary, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding LimitStatusSummary}" Opacity="0.55" FontSize="11" Margin="0,4,0,0"
                                                               Visibility="{Binding LimitStatusSummary, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SplitButton Content="起動" Appearance="Primary" Margin="0,0,6,0"
                                                                     Icon="{ui:SymbolIcon Symbol=Play24}" Command="{Binding StartCommand}"
                                                                     IsDropDownOpen="{Binding IsCustomLaunchOpen, Mode=TwoWay}">
                                                        <ui:SplitButton.Flyout>
                                                            <ContextMenu>
                                                                <MenuItem Focusable="False" StaysOpenOnClick="True">
                                                                    <MenuItem.Header>
                                                                        <StackPanel Margin="4" MinWidth="260">
                                                                            <TextBlock Text="この起動だけ、既定と異なる起動オプションを使う" FontSize="11"
                                                                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                                            <TextBox Text="{Binding CustomLaunchArguments, UpdateSourceTrigger=PropertyChanged}"
                                                                                     Margin="0,0,0,8" />
                                                                            <ui:Button Content="この内容で起動" Appearance="Primary" HorizontalAlignment="Right"
                                                                                       Command="{Binding StartCustomCommand}" />
                                                                        </StackPanel>
                                                                    </MenuItem.Header>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </ui:SplitButton.Flyout>
                                                    </ui:SplitButton>
                                                    <ui:Button Content="続きから" ToolTip="直近の会話を続きから再開して起動 (claude -c)" Appearance="Secondary" Margin="0,0,6,0"
                                                               Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Command="{Binding StartResumeCommand}" />
                                                    <ui:Button Content="停止" Appearance="Danger" Margin="0,0,6,0"
                                                               Icon="{ui:SymbolIcon Symbol=Stop24}" Command="{Binding StopCommand}" />
                                                    <ui:Button ToolTip="編集" Margin="0,0,6,0"
                                                               Icon="{ui:SymbolIcon Symbol=Edit24}" Click="EditSession_Click" />
                                                    <ui:Button ToolTip="削除" Appearance="Secondary"
                                                               Icon="{ui:SymbolIcon Symbol=Delete24}" Click="DeleteSession_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="設定">
                <views:SettingsTab DataContext="{Binding Settings}" />
            </TabItem>

            <TabItem Header="設定ファイル">
                <views:ConfigFilesTab DataContext="{Binding ConfigFiles}" />
            </TabItem>

            <TabItem x:Name="ExtensionsTabItem" Header="拡張機能">
                <views:ExtensionsTab DataContext="{Binding Extensions}" />
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
