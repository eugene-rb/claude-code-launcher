<ui:FluentWindow x:Class="ClaudeLauncher.App.Views.ImportProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="既存プロジェクトから追加" Height="600" Width="520" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="既存プロジェクトから追加" />

        <StackPanel Grid.Row="1" Margin="24,16,24,12">
            <TextBlock Text="~/.claude/projects に実績があるが、まだセッションとして登録されていない作業ディレクトリです。"
                       TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,12" />
            <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="24,0,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyStateText" Text="取り込めるプロジェクトが見つかりませんでした。"
                           Opacity="0.6" Margin="0,24,0,0" HorizontalAlignment="Center" Visibility="Collapsed" />
                <ItemsControl x:Name="RowsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Info.SuggestedName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Info.WorkingDirectory}" Opacity="0.7" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Info.WorkingDirectory}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding LastActivityText}" Opacity="0.5" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12,24,24">
            <ui:Button Content="キャンセル" Appearance="Secondary" Margin="0,0,8,0" IsCancel="True" />
            <ui:Button Content="追加" Appearance="Primary" Click="Add_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
