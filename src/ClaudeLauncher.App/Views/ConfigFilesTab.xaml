<UserControl x:Class="ClaudeLauncher.App.Views.ConfigFilesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ClaudeLauncher.App.ViewModels"
             xmlns:conv="clr-namespace:ClaudeLauncher.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConfigFilesViewModel}"
             d:DesignHeight="500" d:DesignWidth="900">

    <UserControl.Resources>
        <conv:ExistsToBrushConverter x:Key="ExistsToBrushConverter" />
        <conv:ExistsToTextConverter x:Key="ExistsToTextConverter" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter" />
        <conv:NullToBoolConverter x:Key="NullToBoolConverter" />

        <DataTemplate x:Key="EntryRowTemplate" DataType="{x:Type vm:ConfigFileEntryViewModel}">
            <Border Padding="4,6" Cursor="Hand" Background="Transparent"
                    MouseLeftButtonUp="EntryRow_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Definition.DisplayName}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Definition.Description}" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center"
                            Background="{Binding Exists, Converter={StaticResource ExistsToBrushConverter}}">
                        <TextBlock Text="{Binding Exists, Converter={StaticResource ExistsToTextConverter}}" FontSize="10" Foreground="White" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ユーザー全体" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding GlobalEntries}" ItemTemplate="{StaticResource EntryRowTemplate}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card>
                    <StackPanel>
                        <TextBlock Text="プロジェクト固有" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                        <TextBlock Text="既存セッションから選択" FontSize="11" Opacity="0.6" Margin="0,0,0,2" />
                        <ComboBox x:Name="SessionComboBox" ItemsSource="{Binding AvailableSessions}"
                                  DisplayMemberPath="Name" Margin="0,0,0,10"
                                  SelectionChanged="SessionComboBox_SelectionChanged" />

                        <TextBlock Text="プロジェクトディレクトリ" FontSize="11" Opacity="0.6" Margin="0,0,0,2" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ProjectDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1" Content="参照" Click="Browse_Click" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ProjectEntries}" ItemTemplate="{StaticResource EntryRowTemplate}" />
                        <TextBlock Text="対象のプロジェクトディレクトリを指定してください" Opacity="0.5" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding ProjectDirectory, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SelectedEntry.Definition.DisplayName, TargetNullValue='ファイルを選択してください'}"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedEntry.ResolvedPath}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="再読み込み" Margin="0,0,6,0" Command="{Binding ReloadCommand}" />
                    <ui:Button Content="保存" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>

            <TextBox Grid.Row="1" x:Name="ContentTextBox"
                     Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     IsEnabled="{Binding SelectedEntry, Converter={StaticResource NullToBoolConverter}}" />

            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Opacity="0.7" FontSize="12" Margin="0,8,0,0" />
        </Grid>
    </Grid>
</UserControl>
