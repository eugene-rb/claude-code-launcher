<UserControl x:Class="ClaudeLauncher.App.Views.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ClaudeLauncher.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="500" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="設定" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />

            <ui:Card Margin="0,0,0,16">
                <StackPanel Margin="4">
                    <TextBlock Text="既定の起動コマンド" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="新規プロジェクトを「起動」するとき、標準で使われる実行コマンドとオプションです。個別のプロジェクトごとに変えたい場合は、起動ボタン横のドロップダウンからその都度指定できます。"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <TextBlock Text="実行コマンド" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DefaultExecutable, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                    <TextBlock Text="起動オプション" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DefaultArguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                    <TextBlock Text="例: --model sonnet" FontSize="11" Opacity="0.45" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,16">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="利用上限からの自動再開" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6">
                            応答の途中で利用上限に達したことを検知したら、リセット時刻の5分後に自動で
                            <Run Text="-c" FontFamily="Consolas" />
                            (直前の会話を継続)で起動し直します。全プロジェクトに適用されます。アプリを起動している間(タスクバーに常駐中も含む)のみ有効です。
                        </TextBlock>
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoResumeOnLimitEnabled}" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,16">
                <StackPanel Margin="4">
                    <TextBlock Text="再開時の会話" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,0,0,16">
                        自動再開と「再開」ボタンが
                        <Run Text="-c" FontFamily="Consolas" />
                        で起動するとき、直前の会話をどう引き継ぐかです。長く大きく育った会話ではClaude Code側が確認画面を出して入力待ちで止まってしまうため、ここで選んだほうをランチャーが代わりに答えます。
                    </TextBlock>

                    <ComboBox ItemsSource="{Binding ResumeModeOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding ResumeMode}"
                              HorizontalAlignment="Left" MinWidth="280" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding ResumeModeDetail}" TextWrapping="Wrap" FontSize="11" Opacity="0.45" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,16">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Windows起動時に自動起動" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                                   Text="サインイン時にタスクバーへ常駐した状態で自動的に起動します。" />
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding StartWithWindowsEnabled}" />
                </Grid>
            </ui:Card>

            <ui:Card>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="アップデート" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock FontSize="12" Opacity="0.6"
                                   Text="{Binding Update.CurrentVersionText, StringFormat='現在のバージョン: {0}'}" />
                    </StackPanel>

                    <ui:Button Grid.Column="1" Content="今すぐ確認" Appearance="Secondary" VerticalAlignment="Center"
                               Command="{Binding Update.CheckNowCommand}" />
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
