<UserControl x:Class="ClaudeLauncher.App.Views.ExtensionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ClaudeLauncher.App.ViewModels"
             xmlns:models="clr-namespace:ClaudeLauncher.App.Models"
             xmlns:conv="clr-namespace:ClaudeLauncher.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ExtensionsViewModel}"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <conv:EnabledToToggleLabelConverter x:Key="EnabledToToggleLabelConverter" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#22FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <TextBlock Text="変更は次回のセッション起動時から反映されます(または /reload-plugins)。終了コードは非公開のため、下部のログにコマンドの生出力をそのまま表示します。"
                       TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
        </Border>

        <Grid Grid.Row="1" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="インストール済みプラグイン" FontWeight="SemiBold" FontSize="14" />
                                <ui:Button Grid.Column="1" Content="更新" Command="{Binding RefreshCommand}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding InstalledPlugins}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InstalledPluginItemViewModel}">
                                        <Border Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="#22FFFFFF">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Info.Id}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock FontSize="11" Opacity="0.6">
                                                    <Run Text="{Binding Info.Version, Mode=OneWay}" />
                                                    <Run Text=" / " />
                                                    <Run Text="{Binding Info.Scope, Mode=OneWay}" />
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <ui:Button Content="{Binding Enabled, Converter={StaticResource EnabledToToggleLabelConverter}}"
                                                               Margin="0,0,6,0" FontSize="11"
                                                               Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Content="削除" Appearance="Secondary" FontSize="11"
                                                               Command="{Binding DataContext.UninstallPluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="マーケットプレイス" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewMarketplaceSource, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                <ui:Button Grid.Column="1" Content="追加" Command="{Binding AddMarketplaceCommand}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Marketplaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:MarketplaceInfo}">
                                        <Border Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="#22FFFFFF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding Repo}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding Repo, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding Url}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding Url, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Content="削除" Appearance="Secondary" FontSize="11"
                                                           VerticalAlignment="Top"
                                                           Command="{Binding DataContext.RemoveMarketplaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card>
                        <StackPanel>
                            <TextBlock Text="スキル" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <TextBox Text="{Binding NewSkillName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                     ToolTip="新規スキル名" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewSkillDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,8,0" ToolTip="説明(任意)" />
                                <ui:Button Grid.Column="1" Content="作成" Command="{Binding CreateSkillCommand}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Skills}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SkillInfo}">
                                        <Border Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="#22FFFFFF">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                                           Visibility="{Binding Description, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <ui:Button Content="フォルダを開く" Margin="0,0,6,0" FontSize="11"
                                                               Command="{Binding DataContext.OpenSkillFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Content="検証" Appearance="Secondary" FontSize="11"
                                                               Command="{Binding DataContext.ValidateSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="プラグインを探す" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="名前・説明で検索" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailablePluginsView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AvailablePluginInfo}">
                                <ui:Card Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                                       MaxHeight="48" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Opacity="0.5" Margin="0,4,0,0">
                                                <Run Text="{Binding MarketplaceName, Mode=OneWay}" />
                                                <Run Text=" · インストール数 " />
                                                <Run Text="{Binding InstallCount, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <ui:Button Content="詳細" Margin="0,0,0,6" FontSize="11"
                                                       Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button Content="インストール" Appearance="Primary" FontSize="11"
                                                       Command="{Binding DataContext.InstallPluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Text="操作ログ" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,6" />
                <TextBox Grid.Row="3" x:Name="LogTextBox" Text="{Binding OperationLog, Mode=OneWay}"
                         IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" TextChanged="LogTextBox_TextChanged" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
