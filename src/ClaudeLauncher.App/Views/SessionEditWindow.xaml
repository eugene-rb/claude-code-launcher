<ui:FluentWindow x:Class="ClaudeLauncher.App.Views.SessionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="セッション設定" Height="560" Width="520" MinWidth="480" MinHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="セッション設定" />

        <StackPanel Grid.Row="1" Margin="24">
            <TextBlock Text="名前" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
            <TextBox x:Name="NameTextBox" Margin="0,0,0,16" />

            <TextBlock Text="作業ディレクトリ" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WorkingDirectoryTextBox" Grid.Column="0" Margin="0,0,8,0" />
                <ui:Button Grid.Column="1" Content="参照..." Click="Browse_Click" />
            </Grid>

            <TextBlock Text="実行コマンド" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
            <TextBox x:Name="ExecutableTextBox" Margin="0,0,0,16" />

            <TextBlock Text="起動オプション" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
            <TextBox x:Name="ArgumentsTextBox" Margin="0,0,0,4" />
            <TextBlock Text="例: --resume --model sonnet" FontSize="11" Opacity="0.45" Margin="0,0,0,16" />

            <TextBlock Text="アクセントカラー" FontSize="12" Opacity="0.7" Margin="0,0,0,8" />
            <StackPanel x:Name="AccentColorPanel" Orientation="Horizontal" Margin="0,0,0,16" />

            <TextBlock x:Name="ValidationTextBlock" Foreground="#D13438" TextWrapping="Wrap"
                       Margin="0,0,0,12" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <ui:Button Content="キャンセル" Appearance="Secondary" Margin="0,0,8,0" IsCancel="True" />
                <ui:Button Content="保存" Appearance="Primary" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
